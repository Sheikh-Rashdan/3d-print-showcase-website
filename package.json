{
  "name": "3d-print-showcase",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.js",
    "server": "node backend/server.js",
    "dev:full": "concurrently \"npm run server\" \"npm run dev -- --host\"",
    "build": "vite --config frontend/vite.config.js",
    "lint": "oxlint",
    "preview": "vite preview --config frontend/vite.config.js"
  },
  "dependencies": {
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}